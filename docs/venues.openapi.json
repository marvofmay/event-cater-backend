                  "nullable": true
                }
              },
              "required": [
                "name",
                "phone"
              ]
            }
          },
          "notes": {
            "type": "string",
            "nullable": true,
            "maxLength": 4000
          },
          "serviceMode": {
            "type": "string",
            "enum": [
              "off_site",
              "on_site"
            ],
            "default": "off_site"
          }
        },
        "required": [
          "name",
          "location",
          "contacts"
        ]
      },
